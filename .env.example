# Media Download Stack - Environment Configuration
# =================================================
# Copy this file to .env and fill in your values before running:
#   cp .env.example .env
#   docker compose up -d

# ============================================================================
# VPN Configuration (REQUIRED)
# ============================================================================

# NordVPN Authentication Token
# Get yours from: https://nordvpn.com/account/
VPN_TOKEN=your_nordvpn_token_here

# VPN Server Location (optional - NordVPN auto-selects if not specified)
# Format: Country_City or just Country (e.g., United_States, Germany, Netherlands)
VPN_LOCATION=United_States

# ============================================================================
# User/Group IDs (for file permissions)
# ============================================================================

# Your Linux user ID (usually 1000 for first user)
# Find with: id -u
PUID=1000

# Your Linux group ID (usually 1000 for first user)
# Find with: id -g
PGID=1000

# ============================================================================
# Timezone Configuration
# ============================================================================

# See https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Examples: America/New_York, Europe/London, UTC
TZ=America/New_York

# ============================================================================
# Optional Settings (with defaults)
# ============================================================================

# FlareSolverr Log Level (debug, info, warn, error)
LOG_LEVEL=info

# FlareSolverr HTML Logging (true, false)
LOG_HTML=false

# Captcha Solver for FlareSolverr (none, 2captcha, anticaptcha, captricate)
# Use 'none' if you don't need captcha solving
CAPTCHA_SOLVER=none

# ============================================================================
# NOTES:
# - Keep VPN_TOKEN as secret! Never commit .env to git.
# - Adjust PUID/PGID if your Linux user is different from 1000
# - All data volumes are relative paths (./config/, ./data/)
# - See README.md for full setup instructions
